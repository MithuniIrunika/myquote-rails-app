<h2>Administrator Dashboard</h2>
<p class="lead">Hello, <strong><%= current_user.fname %></strong>. You are signed in as an administrator.</p>

<div class="row">
  <div class="col-md-3">
    <div class="card text-bg-primary mb-3"><div class="card-body">
      <h6 class="card-title">Total Users</h6><h3><%= @user_count %></h3>
    </div></div>
  </div>
  <div class="col-md-3">
    <div class="card text-bg-success mb-3"><div class="card-body">
      <h6 class="card-title">Total Quotes</h6><h3><%= @quote_count %></h3>
    </div></div>
  </div>
  <div class="col-md-3">
    <div class="card text-bg-warning mb-3"><div class="card-body">
      <h6 class="card-title">Suspended</h6><h3><%= @suspended_count %></h3>
    </div></div>
  </div>
  <div class="col-md-3">
    <div class="card text-bg-danger mb-3"><div class="card-body">
      <h6 class="card-title">Banned</h6><h3><%= @banned_count %></h3>
    </div></div>
  </div>
</div>

<div class="row mt-3">
  <div class="col-md-4">
    <div class="card mb-3"><div class="card-body">
      <h5 class="card-title">Manage Users</h5>
      <p>Set user status (Active, Suspended, Banned), elevate to admin, or delete user accounts.</p>
      <%= link_to "Manage Users", users_path, class: "btn btn-primary" %>
    </div></div>
  </div>
  <div class="col-md-4">
    <div class="card mb-3"><div class="card-body">
      <h5 class="card-title">Manage Philosophers</h5>
      <p>Add, edit or remove philosophers (<%= @philosopher_count %> currently).</p>
      <%= link_to "Manage Philosophers", philosophers_path, class: "btn btn-primary" %>
    </div></div>
  </div>
  <div class="col-md-4">
    <div class="card mb-3"><div class="card-body">
      <h5 class="card-title">Manage Categories</h5>
      <p>Add, edit or remove categories (<%= @category_count %> currently).</p>
      <%= link_to "Manage Categories", categories_path, class: "btn btn-primary" %>
    </div></div>
  </div>
</div>