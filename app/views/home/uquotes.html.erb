<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>My Quotes</h2>
  <%= link_to "Add New Quote", new_quote_path, class: "btn btn-success" %>
</div>

<% if @quotes.empty? %>
  <p class="text-muted">You have not added any quotes yet. <%= link_to "Add your first quote", new_quote_path %>.</p>
<% else %>
  <% @quotes.each do |quote| %>
    <%= render "quotes/quote", quote: quote %>
  <% end %>
<% end %>