<%= form_with(model: @quote, local: true) do |f| %>
  <% if @quote.errors.any? %>
    <div class="alert alert-danger">
      <h5><%= pluralize(@quote.errors.count, "error") %> prevented this quote from being saved:</h5>
      <ul class="mb-0">
        <% @quote.errors.full_messages.each do |msg| %>
          <li><%= msg %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group mb-3">
    <%= f.label :qtext, "Quote Text", class: "form-label" %>
    <%= f.text_area :qtext, rows: 4, class: "form-control", placeholder: "Enter the quote..." %>
  </div>

  <div class="form-group mb-3">
    <%= f.label :philosopher_id, "Philosopher", class: "form-label" %>
    <div class="d-flex gap-2 align-items-stretch">
      <%= f.select :philosopher_id,
                   Philosopher.all.sort_by { |p|
                     # "Anonymous" pinned to the top, then by lname / fname
                     [p.fname.to_s.downcase == "anonymous" ? 0 : 1,
                      p.lname.to_s, p.fname.to_s]
                   }.map { |p|
                     label = p.display_name.presence || "Anonymous"
                     label = "#{label} #{p.life_span}" if p.life_span.present?
                     [label, p.id]
                   },
                   { include_blank: "-- Select a philosopher --" },
                   class: "form-select" %>
      <%= link_to "+ Add New Philosopher",
                  new_philosopher_path,
                  class: "btn btn-outline-success text-nowrap" %>
    </div>
    <small class="text-muted">
      Can't find the philosopher? Click "+ Add New Philosopher" to add them, then return to add your quote.
      For unknown sources, choose "Anonymous".
    </small>
  </div>

  <div class="row">
    <div class="col-md-6">
      <div class="form-group mb-3">
        <%= f.label :qyear, "Publication Year (optional)", class: "form-label" %>
        <%= f.text_field :qyear, class: "form-control", placeholder: "e.g. 1843" %>
      </div>
    </div>
    <div class="col-md-6">
      <div class="form-check mt-4 pt-2">
        <%= f.check_box :ispublic, class: "form-check-input" %>
        <%= f.label :ispublic, "Make this quote public", class: "form-check-label" %>
      </div>
    </div>
  </div>

  <div class="form-group mb-3">
    <%= f.label :qcom, "Your Comment (optional)", class: "form-label" %>
    <%= f.text_area :qcom, rows: 2, class: "form-control" %>
  </div>

  <h5 class="mt-4">Categories</h5>
  <p class="text-muted">Assign at least one category to this quote.</p>

  <div id="categories-container">
    <% @quote.quote_categories.each do |qc| %>
      <%= f.fields_for :quote_categories, qc do |qcf| %>
        <div class="category-field row mb-2">
          <div class="col-md-8">
            <%= qcf.select :category_id,
                           Category.order(:catname).map { |c| [c.catname, c.id] },
                           { include_blank: "-- Select a category --" },
                           class: "form-select d-inline-block" %>
            <% if qcf.object.persisted? %>
              <%= qcf.hidden_field :id %>
            <% end %>
          </div>
          <div class="col-md-4 align-self-center">
            <%= link_to "[-] Remove", "#", class: "remove-category text-danger",
                        style: "text-decoration: none;" %>
            <% if qcf.object.persisted? %>
              <%= qcf.hidden_field :_destroy, value: false, class: "destroy-flag" %>
            <% end %>
          </div>
        </div>
      <% end %>
    <% end %>
  </div>

  <div class="mt-3">
    <%= f.submit (@quote.persisted? ? "Update Quote" : "Add Quote"), class: "btn btn-primary btn-lg" %>
    <%= link_to "Cancel",
                (@quote.persisted? ? quote_path(@quote) : your_quotes_path),
                class: "btn btn-link" %>
  </div>
<% end %>

<script>
  document.addEventListener('DOMContentLoaded', function() {
    document.addEventListener('click', function(e) {
      if (e.target && e.target.classList.contains('remove-category')) {
        e.preventDefault();
        const rows = document.querySelectorAll('.category-field');
        if (rows.length > 1) {
          const row = e.target.closest('.category-field');
          const destroyFlag = row.querySelector('.destroy-flag');
          if (destroyFlag) {
            destroyFlag.value = '1';
            row.style.display = 'none';
          } else {
            row.remove();
          }
        }
      }
    });
  });
</script>