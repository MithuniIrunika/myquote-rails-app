<div class="card mb-3 quote-card shadow-sm">
  <div class="card-body">
    <blockquote class="blockquote mb-2">
      <p class="mb-0">"<%= quote.qtext %>"</p>
      <footer class="blockquote-footer mt-2">
        <strong><%= quote.philosopher&.display_name.presence || "Anonymous" %></strong>
        <%= quote.philosopher&.life_span %>
        <% if quote.qyear.present? %> - published <%= quote.qyear %><% end %>
      </footer>
    </blockquote>

    <% if quote.qcom.present? %>
      <p class="text-muted fst-italic">Comment: <%= quote.qcom %></p>
    <% end %>

    <div class="mb-2">
      <% quote.categories.each do |cat| %>
        <span class="badge text-bg-info"><%= cat.catname %></span>
      <% end %>
      <% unless quote.ispublic %>
        <span class="badge private-badge text-light">Private</span>
      <% end %>
    </div>

    <small class="text-muted">
      Added by <strong><%= quote.user&.fname %></strong>
      on <%= quote.created_at.strftime("%d %b %Y") %>
    </small>

    <div class="mt-2">
      <%= link_to "Read full quote", quote_path(quote), class: "btn btn-sm btn-outline-primary" %>
      <% if logged_in? && (current_user.id == quote.user_id || is_administrator?) %>
        <%= link_to "Edit", edit_quote_path(quote), class: "btn btn-sm btn-outline-secondary" %>
        <%= button_to "Delete", quote_path(quote), method: :delete,
                      form: { data: { turbo_confirm: "Delete this quote?" }, style: "display:inline;" },
                      class: "btn btn-sm btn-outline-danger" %>
      <% end %>
    </div>
  </div>
</div>