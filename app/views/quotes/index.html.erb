<div class="d-flex justify-content-between align-items-center mb-3">
  <h2><% if is_administrator? %>All Quotes<% else %>Browse Quotes<% end %></h2>
  <% if logged_in? && !is_administrator? %>
    <%= link_to "Add New Quote", new_quote_path, class: "btn btn-success" %>
  <% end %>
</div>

<% if @quotes.empty? %>
  <p class="text-muted">No quotes available.</p>
<% else %>
  <% @quotes.each do |quote| %>
    <%= render "quote", quote: quote %>
  <% end %>
<% end %>