<!DOCTYPE html>
<html>
  <head>
    <title>MyQuote</title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js" defer></script>

    <style>
      body { padding-top: 70px; background-color: #f7f7f9; }
      .quote-card { border-left: 4px solid #0d6efd; }
      .private-badge { background-color: #6c757d; }
      .alert-success { background-color: #d1e7dd; color: #0f5132; border-color: #badbcc; }
      .alert-danger  { background-color: #f8d7da; color: #842029; border-color: #f5c2c7; }
      .field_with_errors input,
      .field_with_errors textarea,
      .field_with_errors select { border: 2px solid #dc3545 !important; }
    </style>
  </head>

  <body>
    <%= render "layouts/header" %>

    <main class="container py-4">
      <% flash.each do |key, message| %>
        <div class="<%= flash_class(key) %>" role="alert">
          <%= message %>
        </div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>