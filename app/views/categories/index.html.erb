<div class="d-flex justify-content-between align-items-center mb-3">
  <h2>Categories</h2>
  <% if is_administrator? %>
    <%= link_to "Add New Category", new_category_path, class: "btn btn-success" %>
  <% end %>
</div>

<div class="row">
  <% @categories.each do |cat| %>
    <div class="col-md-4 mb-3">
      <div class="card">
        <div class="card-body">
          <h5 class="card-title">
            <%= link_to cat.catname, category_path(cat) %>
          </h5>
          <p class="text-muted"><%= cat.quotes.count %> quote<%= cat.quotes.count == 1 ? "" : "s" %></p>
          <% if is_administrator? %>
            <%= link_to "Edit", edit_category_path(cat), class: "btn btn-sm btn-outline-primary" %>
            <%= button_to "Delete", category_path(cat), method: :delete,
                          form: { data: { turbo_confirm: "Delete category '#{cat.catname}'?" }, style: "display:inline;" },
                          class: "btn btn-sm btn-outline-danger" %>
          <% end %>
        </div>
      </div>
    </div>
  <% end %>
</div>