<div class="row justify-content-center">
  <div class="col-md-6">
    <div class="card shadow-sm">
      <div class="card-body">
        <h2 class="card-title mb-3">Sign In</h2>

        <%= form_with url: login_path, method: :post, local: true do %>
          <div class="form-group mb-3">
            <%= label_tag :email, "Email Address", class: "form-label" %>
            <%= email_field_tag :email, nil, required: true, autofocus: true,
                                placeholder: "you@example.com", class: "form-control" %>
          </div>
          <div class="form-group mb-3">
            <%= label_tag :password, "Password", class: "form-label" %>
            <%= password_field_tag :password, nil, required: true,
                                   placeholder: "Password", class: "form-control" %>
          </div>
          <%= submit_tag "Sign In", class: "btn btn-primary w-100" %>
        <% end %>

        <hr>
        <p class="text-center mb-0">
          Don't have an account? <%= link_to "Sign up", new_user_path %>
        </p>
      </div>
    </div>
  </div>
</div>